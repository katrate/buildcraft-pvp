# Copy to .env (same folder). Server reads this at boot (see server/src/env.ts).
# Required: accounts are mandatory, so every WebSocket handshake must present a
# valid Supabase access token. Without the service role key the server rejects
# all connections and logs a startup warning. See supabase/schema.sql.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
